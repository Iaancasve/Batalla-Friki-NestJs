generator client {
  provider        = "prisma-client-js"
  engineType      = "library"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int        @id @default(autoincrement())
  email     String     @unique
  password  String
  level     Int        @default(1)
  xp        Int        @default(0)
  wins      Int        @default(0)
  losses    Int        @default(0)
  roles     UserRole[]
  
  // Relaciones con las batallas para poder consultar el historial
  battlesAsP1 Battle[]   @relation("Player1")
  battlesAsP2 Battle[]   @relation("Player2")
  battlesWon  Battle[]   @relation("Winner")

  createdAt DateTime   @default(now())
}

model Role {
  id    Int        @id @default(autoincrement())
  name  String     @unique // ADMIN | USER
  users UserRole[] 
}

model UserRole {
  userId Int
  roleId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Character {
  id            Int      @id @default(autoincrement())
  name          String
  hp            Int
  baseHp        Int
  attack        Int
  levelRequired Int      @default(1)
  
  // Relaciones para saber en qué batallas se usó el personaje
  battlesAsChar1 Battle[] @relation("Char1")
  battlesAsChar2 Battle[] @relation("Char2")
}

model Battle {
  id            Int      @id @default(autoincrement())
  
  // Jugadores
  player1Id     Int
  player2Id     Int?     // Opcional para cuando es contra la máquina
  player1       User     @relation("Player1", fields: [player1Id], references: [id])
  player2       User?    @relation("Player2", fields: [player2Id], references: [id])

  // Personajes utilizados
  character1Id  Int
  character2Id  Int
  character1    Character @relation("Char1", fields: [character1Id], references: [id])
  character2    Character @relation("Char2", fields: [character2Id], references: [id])

  // Resultado
  winnerId      Int?     // ID del User que ganó
  winner        User?    @relation("Winner", fields: [winnerId], references: [id])
  
  status        String   @default("STARTED") // STARTED | FINISHED
  createdAt     DateTime @default(now())
}