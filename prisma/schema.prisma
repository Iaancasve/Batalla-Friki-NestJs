// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int        @id @default(autoincrement())
  email     String     @unique
  password  String
  level     Int        @default(1)
  xp        Int        @default(0)
  wins      Int        @default(0)
  losses    Int        @default(0)
  roles     Role[]     // Relación implícita muchos a muchos para simplificar
  createdAt DateTime   @default(now())
}

model Role {
  id    Int    @id @default(autoincrement())
  name  String @unique // ADMIN | USER
  users User[]
}

model Character {
  id            Int      @id @default(autoincrement())
  name          String
  hp            Int
  baseHp        Int
  attack        Int
  levelRequired Int      @default(1)
}

// Nota: El modelo Battle lo añadiremos más adelante cuando toquemos WebSockets